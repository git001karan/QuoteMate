      "expected_needs_clarification": null,
      "expected_is_unsupported": null,
      "expected_duplicated": true,
      "reply_contains": [
        "WC-501",
        "Rs"
      ],
      "cart_should_contain": [
        "WC-501"
      ]
    },
    {
      "event_id": "demo-5-two-independent-users",
      "_msg_index": 0,
      "message_id": "msg_eve_001",
      "sender_id": "user_eve",
      "expected_status": 200,
